# Copiá este archivo como "backend/.env" y completá tus propios valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Usuario y contraseña de la base de datos (los usa la API y Docker)
DB_USER=turnero_user
DB_PASSWORD=cambiar_esta_contrasena

# Contraseña del usuario root de MySQL (solo la usa Docker)
MYSQL_ROOT_PASSWORD=cambiar_esta_contrasena_root

# Conexión
DB_HOST=localhost
DB_PORT=3307
DB_NAME=turnos_medicos_bd
